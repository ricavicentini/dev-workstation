#!/bin/bash

set -uo pipefail

if [[ "${1:-}" == '-fsSL' && -n "${2:-}" && "${3:-}" == '-o' && -n "${4:-}" ]]; then
  printf '%s\n' "$2" >> "${HOMEBREW_TEST_CURL_LOG:?}"
  cp "${HOMEBREW_TEST_INSTALLER:?}" "$4"
  exit 0
fi

if [[ "${1:-}" == '-s' && -n "${2:-}" ]]; then
  printf '%s\n' "$2" >> "${SDKMAN_TEST_CURL_LOG:?}"
  cat "${SDKMAN_TEST_INSTALLER:?}"
  exit 0
fi

exit 64
